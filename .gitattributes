*.pth filter=lfs diff=lfs merge=lfs -text
# Prevent macOS resource fork files
._* export-ignore
# Handle line endings properly
* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
# Ensure shell scripts are executable
*.sh export-ignore text eol=lf
start_hieratic_ai.sh eol=lf
install.py text eol=lf
*.txt text eol=lf
# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.pth binary
